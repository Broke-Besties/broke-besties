// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                     @id @default(cuid())
  name                      String
  email                     String                     @unique
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  members                   GroupMember[]
  sentInvites               GroupInvite[]              @relation("InviteSender")
  receivedInvites           GroupInvite[]              @relation("InviteReceiver")
  lentDebts                 Debt[]                     @relation("Lender")
  borrowedDebts             Debt[]                     @relation("Borrower")
  lentAlerts                Alert[]                    @relation("AlertLender")
  borrowedAlerts            Alert[]                    @relation("AlertBorrower")
  debtTransactions          DebtTransaction[]          @relation("TransactionRequester")
  recurringPayments         RecurringPayment[]         @relation("RecurringPaymentLender")
  recurringPaymentBorrowers RecurringPaymentBorrower[]
  friends                   Friend[]                   @relation("FriendRequester")
  friendsReceived           Friend[]                   @relation("FriendRecipient")
  uploadedReceipts          Receipt[]                  @relation("ReceiptUploader")
  wallet                    Wallet?
  premium                   Boolean                    @default(false)
  signedUp                  Boolean                    @default(true)
  // User preferences JSON: theme, calendar timezone/colors, etc.
  preferences               Json?
  mcpTokens                 McpToken[]
  calendarEvents            CalendarEvent[]            @relation("CalendarEventOwner")
  eventRsvps                EventRsvp[]                @relation("EventRsvpUser")
  calendarSubscriptions     CalendarSubscription[]     @relation("CalendarSubscriptionUser")
}

model McpToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  // Balance stored in cents to avoid floating point issues
  balanceCents    Int      @default(0)
  stripeAccountId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String // "deposit" or "withdraw"
  status      String   @default("pending") // "pending", "completed", "failed"
  amountCents Int
  currency    String   @default("usd")
  // Stripe reference: checkout session id for deposits, transfer id for withdrawals
  stripeRef   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type, status])
}

model Group {
  id                Int                @id @default(autoincrement())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  members           GroupMember[]
  invites           GroupInvite[]
  debts             Debt[]
  recurringPayments RecurringPayment[]
  alerts            Alert[]
  calendarShares    CalendarEventShare[]
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  userId    String
  groupId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model GroupInvite {
  id           Int      @id @default(autoincrement())
  groupId      Int
  invitedBy    String
  invitedEmail String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender   User  @relation("InviteSender", fields: [invitedBy], references: [id], onDelete: Cascade)
  receiver User? @relation("InviteReceiver", fields: [invitedEmail], references: [email], onDelete: Cascade)

  @@unique([groupId, invitedEmail])
  @@index([invitedEmail])
  @@index([groupId])
}

model Debt {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String?
  status      String   @default("pending")
  lenderId    String
  borrowerId  String
  groupId     Int?
  alertId     Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lender       User              @relation("Lender", fields: [lenderId], references: [id], onDelete: Cascade)
  borrower     User              @relation("Borrower", fields: [borrowerId], references: [id], onDelete: Cascade)
  group        Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  alert        Alert?            @relation(fields: [alertId], references: [id], onDelete: SetNull)
  transactions DebtTransaction[]
  receipts     Receipt[]

  @@index([lenderId])
  @@index([borrowerId])
  @@index([groupId])
  @@index([alertId])
}

model Alert {
  id                    Int       @id @default(autoincrement())
  message               String?
  deadline              DateTime?
  groupId               Int?
  lenderId              String
  borrowerId            String
  isActive              Boolean   @default(false)
  reminderFrequencyDays Int?
  lastReminderSentAt    DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  group    Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  lender   User   @relation("AlertLender", fields: [lenderId], references: [id], onDelete: Cascade)
  borrower User   @relation("AlertBorrower", fields: [borrowerId], references: [id], onDelete: Cascade)

  debt             Debt?
  recurringPayment RecurringPayment?

  @@index([groupId])
  @@index([lenderId])
  @@index([borrowerId])
  @@index([isActive])
  @@index([deadline])
  @@index([reminderFrequencyDays])
}

model Receipt {
  id         String   @id @default(cuid())
  rawText    String?
  uploaderId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  uploader User?         @relation("ReceiptUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  items    ReceiptItem[]
  debts    Debt[]
}

model ReceiptItem {
  id        String   @id @default(cuid())
  receiptId String
  name      String
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model DebtTransaction {
  id     Int    @id @default(autoincrement())
  debtId Int
  type   String // "drop", "modify", or "confirm_paid"
  status String @default("pending") // "pending", "approved", "rejected", "cancelled"

  requesterId      String
  lenderApproved   Boolean @default(false)
  borrowerApproved Boolean @default(false)

  // For modifications only
  proposedAmount      Float?
  proposedDescription String?
  reason              String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  debt      Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)
  requester User @relation("TransactionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([requesterId])
  @@index([status])
}

model RecurringPayment {
  id          Int      @id @default(autoincrement())
  amount      Float
  description String?
  status      String   @default("active") // "active" or "inactive"
  lenderId    String
  groupId     Int?
  alertId     Int?     @unique
  frequency   Int // Frequency in days
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lender    User                       @relation("RecurringPaymentLender", fields: [lenderId], references: [id], onDelete: Cascade)
  group     Group?                     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  alert     Alert?                     @relation(fields: [alertId], references: [id], onDelete: SetNull)
  borrowers RecurringPaymentBorrower[]

  @@index([lenderId])
  @@index([groupId])
  @@index([alertId])
}

model RecurringPaymentBorrower {
  id                 Int              @id @default(autoincrement())
  userId             String
  recurringPaymentId Int
  splitPercentage    Float // Percentage of the total amount this borrower owes (0-100)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringPayment   RecurringPayment @relation(fields: [recurringPaymentId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([userId, recurringPaymentId])
  @@index([userId])
  @@index([recurringPaymentId])
}

model Friend {
  id          Int      @id @default(autoincrement())
  requesterId String
  recipientId String
  status      String   @default("pending") // "pending" or "accepted"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("FriendRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  description String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  // "app" for events planned in Broke Besties, otherwise the import source.
  source      String   @default("app")
  // Stable identifier from the imported calendar (UID or UID+occurrence).
  externalId  String?
  // When false the event shows as free instead of busy.
  busy        Boolean  @default(true)
  // "confirmed" or "cancelled"
  status      String   @default("confirmed")
  subscriptionId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner        User                 @relation("CalendarEventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shares       CalendarEventShare[]
  rsvps        EventRsvp[]
  subscription CalendarSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([ownerId, source, externalId])
  @@index([ownerId, startsAt])
  @@index([startsAt, endsAt])
  @@index([subscriptionId])
}

model CalendarEventShare {
  id         Int      @id @default(autoincrement())
  eventId    String
  groupId    Int
  // "details" shares the title/location; "busy" only blocks the time.
  visibility String   @default("details")
  // Whether people in this group may RSVP or only view the event.
  allowRsvp  Boolean  @default(true)
  createdAt  DateTime @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([eventId, groupId])
  @@index([eventId])
  @@index([groupId])
}

model EventRsvp {
  id        Int      @id @default(autoincrement())
  eventId   String
  userId    String
  // "pending", "yes", or "no"
  response  String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation("EventRsvpUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model CalendarSubscription {
  id           Int       @id @default(autoincrement())
  userId       String
  name         String
  url          String
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User            @relation("CalendarSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  events CalendarEvent[]

  @@unique([userId, url])
  @@index([userId])
}
