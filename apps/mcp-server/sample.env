# Public origin of this MCP server (what MCP clients connect to)
MCP_BASE_URL=http://localhost:8082
PORT=8082

# Postgres (same database the web app uses)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase project (same as apps/web: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<anon key>

# Secret used to sign first-party MCP access tokens (openssl rand -base64 32)
MCP_JWT_SECRET=<random secret>
